# =============================================================================
#  Variables de entorno — EventPlanner QIM (backend)
#  Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.
#  En producción (Render) estas variables se cargan en el panel "Environment".
# =============================================================================

# --- SERVIDOR ---
PORT=5000
NODE_ENV=development
TZ=America/Guayaquil

# --- BASE DE DATOS ---
# Producción (Neon): usa solo DATABASE_URL (incluye usuario, contraseña y SSL)
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Local: si DATABASE_URL no está definida se usan estas
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quinta_ines_maria
DB_USER=postgres
DB_PASSWORD=

# --- AUTENTICACIÓN (JWT) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- URLs ---
# FRONTEND_URL admite varias separadas por coma (sin "/" al final)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- CORREO ---
# Producción: API de Brevo (Render gratis bloquea SMTP)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Quinta Inés María
# Desarrollo local (solo si no hay BREVO_API_KEY): Gmail con contraseña de aplicación
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- IMÁGENES (Cloudinary) ---
# Si está vacía, las imágenes se guardan en backend/public/uploads (solo para local)
CLOUDINARY_URL=

# --- GOOGLE GEMINI AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- OAuth Google (https://console.cloud.google.com/) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Reseñas de Google Maps (opcional, requiere facturación en Google Cloud) ---
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- OAuth Microsoft ---
# ⚠ No configurar en producción (ver docs/PLAN_DESPLIEGUE.md, hallazgo 18)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
